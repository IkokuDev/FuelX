# ---- Core ----
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
# Leave blank in development to boot an in-memory MongoDB (zero-key). Required in production.
MONGODB_URI=

# ---- Auth ----
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_HMAC_SECRET=dev-otp-hmac-secret-change-me-0123456789
CORS_ORIGINS=http://localhost:3000

# ---- Providers ----
PAYMENT_DRIVER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
ROUTING_DRIVER=haversine
ORS_API_KEY=
GEOCODE_DRIVER=nominatim
GEOCODE_USER_AGENT=FuelX-MVP/1.0
MAIL_DRIVER=console
SMTP_URL=
MAIL_FROM=FuelX <no-reply@fuelx.test>
STORAGE_DRIVER=local
CLOUDINARY_URL=
PUSH_DRIVER=noop
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@fuelx.test

# ---- Limits and geofences ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
STATION_GEOFENCE_M=150
DROPOFF_GEOFENCE_M=200
LOG_LEVEL=info

# ---- Seed (seed script only; refused in production) ----
SEED_ADMIN_EMAIL=admin@fuelx.test
SEED_ADMIN_PASSWORD=ChangeMe123!
